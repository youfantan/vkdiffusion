#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer TensorInput {
    float data[];
} input_tensor;

layout(std430, set = 0, binding = 1) readonly buffer TensorWeight {
    float data[];
} weight_tensor;

layout(std430, set = 0, binding = 2) readonly buffer TensorBias {
    float data[];
} bias_tensor;

layout(std430, set = 0, binding = 3) buffer TensorOutput {
    float data[];
} output_tensor;

layout(push_constant) uniform LayerNormParams {
    uvec4 input_shape; // [N, L, C]
    uvec4 input_stride;
    uint weight_shape;
    float eps;
} layer_norm_params;

shared float group_sum[256];

uint input_offset(uint n, uint l, uint c) {
    return n * layer_norm_params.input_stride.x +
            l * layer_norm_params.input_stride.y +
            c * layer_norm_params.input_stride.z;
}

void main() {
    uint N = layer_norm_params.input_shape.x;
    uint L = layer_norm_params.input_shape.y;
    uint C = layer_norm_params.input_shape.z;

    uint n = gl_WorkGroupID.x;
    uint l = gl_WorkGroupID.y;
    if (n >= N || l >= L) {
        return;
    }
    uint elements_per_group = C;
    uint tX = gl_LocalInvocationID.x;
    uint tY = gl_LocalInvocationID.y;
    uint tid =  (tY * 16) + tX;
    uint elements_per_invocation = (C + 255) / 256;
    float sum = 0.0f;
    for (uint i = 0; i < elements_per_invocation; ++i) {
        if (tid * elements_per_invocation + i >= C) break;
        uint index = input_offset(n, l, tid * elements_per_invocation + i);
        sum += input_tensor.data[index];
    }
    group_sum[tid] = sum;
    barrier();
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (tid < stride) {
            group_sum[tid] += group_sum[tid + stride];
        }
        barrier();
    }
    float mu = group_sum[0] / elements_per_group;
    barrier();
    sum = 0.0f;
    for (uint i = 0; i < elements_per_invocation; ++i) {
        if (tid * elements_per_invocation + i >= C) break;
        uint index = input_offset(n, l, tid * elements_per_invocation + i);
        sum += (input_tensor.data[index] - mu) * (input_tensor.data[index] - mu);
    }
    group_sum[tid] = sum;
    barrier();
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (tid < stride) {
            group_sum[tid] += group_sum[tid + stride];
        }
        barrier();
    }
    float sigma_2 = group_sum[0] / elements_per_group;
    float sigma = sqrt(sigma_2 + layer_norm_params.eps);
    for (uint i = 0; i < elements_per_invocation; ++i) {
        if (tid * elements_per_invocation + i >= C) break;
        uint index = input_offset(n, l, tid * elements_per_invocation + i);
        float alpha = weight_tensor.data[tid * elements_per_invocation + i];
        float beta = bias_tensor.data[tid * elements_per_invocation + i];
        output_tensor.data[index] = (input_tensor.data[index] - mu) / sigma * alpha + beta;
    }
}