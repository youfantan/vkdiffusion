#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer TensorInput {
    float data[];
} input_tensor;

layout(std430, set = 0, binding = 1) buffer TensorOutput {
    float data[];
} output_tensor;

layout(push_constant) uniform SiLUParams {
    uint size;
    uint block;
    uint dispatch_width;
} silu_params;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint total_x = silu_params.dispatch_width * 16u;
    uint index = (y * total_x + x) * silu_params.block;
    for (uint i = 0; i < silu_params.block; ++i) {
        uint j = index + i;
        if (j >= silu_params.size) return;
        output_tensor.data[j] = input_tensor.data[j] / (1 + exp(-input_tensor.data[j]));
    }
}
